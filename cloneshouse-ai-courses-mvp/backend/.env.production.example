# Server
PORT=4000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/cloneshouse_ai_courses

# Production app URLs
FRONTEND_URL=https://ai.cloneshouse.com
API_BASE_URL=https://api-ai.cloneshouse.com

# Payment mode
PAYMENTS_MOCK_MODE=false

# Paystack live
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://ai.cloneshouse.com/payment-success

# Squad live
SQUAD_SECRET_KEY=your_squad_live_secret_key
SQUAD_BASE_URL=https://api-d.squadco.com
SQUAD_CALLBACK_URL=https://ai.cloneshouse.com/payment-success
SQUAD_WEBHOOK_SIGNATURE_REQUIRED=true

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_CUSTOM_GPTS_MEETING_ID=
ZOOM_AI_AGENTS_MEETING_ID=

# Email / Google Workspace SMTP
EMAIL_FROM=foundation@cloneshouse.com
ADMIN_EMAIL=foundation@cloneshouse.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=foundation@cloneshouse.com
SMTP_PASS=your_google_app_password

# Google Sheets Apps Script webhook
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec