# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/cloneshouse_ai_courses

# App URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Payment mode
PAYMENTS_MOCK_MODE=false

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment-success

# Squad
SQUAD_SECRET_KEY=
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_CALLBACK_URL=http://localhost:5173/payment-success
SQUAD_WEBHOOK_SIGNATURE_REQUIRED=true

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_CUSTOM_GPTS_MEETING_ID=
ZOOM_AI_AGENTS_MEETING_ID=

# Email / Google Workspace SMTP
EMAIL_FROM=foundation@cloneshouse.com
ADMIN_EMAIL=foundation@cloneshouse.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=foundation@cloneshouse.com
SMTP_PASS=

# Google Sheets Apps Script webhook
GOOGLE_SHEETS_WEBHOOK_URL=